<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>내 안의 불꽃을 깨우라! - 소그룹 공과 워크북</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts (Noto Sans KR & Playfair Display) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@700;800&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Noto Sans KR', sans-serif;
      background-color: #fdfbf7;
    }
    .font-serif-kr {
      font-family: 'Nanum Myeongjo', serif;
    }
    .custom-shadow {
      box-shadow: 0 10px 30px -5px rgba(245, 158, 11, 0.15);
    }
    .card-gradient {
      background: linear-gradient(135deg, #fffcf6 0%, #fff8eb 100%);
    }
  </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col justify-between selection:bg-amber-200">

  <!-- TOP DECORATION BAR -->
  <div class="h-2 bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 w-full"></div>

  <!-- MAIN CONTAINER -->
  <main class="max-w-xl w-full mx-auto px-4 py-8 flex-grow">
    
    <!-- HEADER -->
    <header class="text-center mb-8">
      <div class="inline-flex items-center justify-center space-x-2 bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-semibold mb-3">
        <span>🔥역대하 29장 2-11절</span>
        <span class="w-1 h-1 bg-amber-400 rounded-full"></span>
        <span>청년부 소그룹 공과</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight leading-tight font-serif-kr">
        내 안의 <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">불꽃</span>을 깨우라!
      </h1>
      <p class="text-slate-500 text-sm mt-2">부지런함을 가장한 영적 게으름에서 벗어나기</p>
    </header>

    <!-- INTRO NAME INPUT (IF NOT SET) -->
    <div id="name-screen" class="bg-white rounded-3xl p-6 border border-amber-100 custom-shadow mb-8 text-center">
      <div class="w-16 h-16 bg-amber-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-amber-500">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1A3.75 3.75 0 0 0 12 18Z" />
        </svg>
      </div>
      <h3 class="font-bold text-lg text-slate-800 mb-2">반가워요! 리더(원)의 이름은 무엇인가요?</h3>
      <p class="text-xs text-slate-500 mb-6">작성하신 내용은 기기에만 안전하게 임시 저장되며, 멋진 결단 카드로 만들어집니다.</p>
      
      <div class="flex space-x-2">
        <input type="text" id="user-name" placeholder="이름을 입력하세요" class="flex-grow px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent text-center font-semibold text-lg">
        <button onclick="startWorkbook()" class="bg-slate-900 hover:bg-slate-800 text-white px-6 py-3 rounded-xl font-bold transition duration-200">
          시작하기
        </button>
      </div>
    </div>

    <!-- WORKBOOK CONTENT (HIDDEN BY DEFAULT) -->
    <div id="workbook-screen" class="hidden space-y-8">
      
      <!-- WELCOME BAR -->
      <div class="bg-amber-50 rounded-2xl p-4 border border-amber-200/50 flex items-center justify-between">
        <span class="text-slate-700 font-medium">🔥 <span id="display-name" class="font-bold text-amber-900"></span>님, 환영합니다!</span>
        <span class="text-xs bg-amber-200 text-amber-900 px-2 py-1 rounded-full font-bold">Progress <span id="progress-text">1/4</span></span>
      </div>

      <!-- STEP NAVIGATION TAB -->
      <div class="flex bg-slate-100 p-1 rounded-xl overflow-x-auto text-xs font-semibold text-slate-500">
        <button id="tab-1" onclick="switchStep(1)" class="flex-1 py-2 rounded-lg text-center whitespace-nowrap bg-white text-slate-900 shadow-sm">1. 마음열기</button>
        <button id="tab-2" onclick="switchStep(2)" class="flex-1 py-2 rounded-lg text-center whitespace-nowrap">2. 말씀연구</button>
        <button id="tab-3" onclick="switchStep(3)" class="flex-1 py-2 rounded-lg text-center whitespace-nowrap">3. 삶의적용</button>
        <button id="tab-4" onclick="switchStep(4)" class="flex-1 py-2 rounded-lg text-center whitespace-nowrap">4. 불꽃결단</button>
      </div>

      <!-- STEP 1: 마음 열기 (ICEBREAKER) -->
      <div id="step-1-content" class="step-content space-y-6">
        <div class="bg-white rounded-3xl p-6 border border-slate-100 custom-shadow">
          <h2 class="text-xl font-bold text-slate-900 mb-2 flex items-center space-x-2">
            <span class="text-amber-500">Q1.</span>
            <span>'부지런함을 가장한 게으름' 체크리스트</span>
          </h2>
          <p class="text-slate-500 text-xs leading-relaxed mb-4">
            세상 일엔 온 에너지를 쏟아 바쁘게 살아가지만, 영적으로는 나태하지 않은가요? 정직하게 체크해 봅시다!
          </p>

          <div class="space-y-3">
            <label class="flex items-start p-3 rounded-xl border border-slate-100 hover:bg-amber-50/30 transition cursor-pointer">
              <input type="checkbox" class="icebreaker-chk mt-1 mr-3 rounded border-slate-300 text-amber-500 focus:ring-amber-400" onchange="calcLaziness()">
              <span class="text-sm text-slate-700">유튜브 쇼츠, 인스타 릴스, 웹툰 등을 보며 1시간 이상 훌쩍 보낸다.</span>
            </label>
            <label class="flex items-start p-3 rounded-xl border border-slate-100 hover:bg-amber-50/30 transition cursor-pointer">
              <input type="checkbox" class="icebreaker-chk mt-1 mr-3 rounded border-slate-300 text-amber-500 focus:ring-amber-400" onchange="calcLaziness()">
              <span class="text-sm text-slate-700">"피곤해", "너무 바빠"라는 말을 입에 달고 살지만, 취미나 약속엔 열심을 낸다.</span>
            </label>
            <label class="flex items-start p-3 rounded-xl border border-slate-100 hover:bg-amber-50/30 transition cursor-pointer">
              <input type="checkbox" class="icebreaker-chk mt-1 mr-3 rounded border-slate-300 text-amber-500 focus:ring-amber-400" onchange="calcLaziness()">
              <span class="text-sm text-slate-700">시험 기간이나 중요한 과제가 있을 땐 주일 예배나 기도 시간을 가장 먼저 양보한다.</span>
            </label>
            <label class="flex items-start p-3 rounded-xl border border-slate-100 hover:bg-amber-50/30 transition cursor-pointer">
              <input type="checkbox" class="icebreaker-chk mt-1 mr-3 rounded border-slate-300 text-amber-500 focus:ring-amber-400" onchange="calcLaziness()">
              <span class="text-sm text-slate-700">말씀을 읽거나 기도하는 시간이 주 1회 미만(혹은 주일예배 때만)이다.</span>
            </label>
            <label class="flex items-start p-3 rounded-xl border border-slate-100 hover:bg-amber-50/30 transition cursor-pointer">
              <input type="checkbox" class="icebreaker-chk mt-1 mr-3 rounded border-slate-300 text-amber-500 focus:ring-amber-400" onchange="calcLaziness()">
              <span class="text-sm text-slate-700">신앙적으로 결단하거나 다짐한 일들을 차일피일 미루고 있다.</span>
            </label>
          </div>

          <!-- LAZINESS METER -->
          <div class="mt-6 p-4 bg-orange-50 rounded-2xl border border-orange-100">
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-bold text-orange-800">나의 영적 방치 점수:</span>
              <span id="laziness-score" class="text-lg font-black text-orange-600">0%</span>
            </div>
            <div class="w-full bg-slate-200 h-2.5 rounded-full overflow-hidden">
              <div id="laziness-bar" class="bg-gradient-to-r from-orange-400 to-red-500 h-full w-0 transition-all duration-500"></div>
            </div>
            <p id="laziness-feedback" class="text-xs text-orange-700 mt-2 font-medium">
              체크해보며 나의 영적인 민낯을 솔직히 고백해 봅시다!
            </p>
          </div>
        </div>

        <!-- DISCUSS 1 -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 custom-shadow">
          <h3 class="font-bold text-slate-900 mb-3 flex items-center space-x-1.5 text-sm uppercase tracking-wide">
            <span class="w-1.5 h-3 bg-amber-500 rounded-full"></span>
            <span>나눔 1. 생각 나누기</span>
          </h3>
          <p class="text-slate-600 text-sm mb-4 leading-relaxed">
            김남준 목사님은 게으름을 <strong>"빗나간 자기 사랑"</strong>(하나님의 뜻과 상관없이 내가 좋아하는 것에만 열심히 몰두하는 상태)이라고 정의했습니다. 내 삶에서 가장 부지런하게 움직이는 분야는 무엇이며, 반대로 영적으로 가장 소홀히 방치하고 있는 부분은 무엇인지 적어봅시다.
          </p>
          <textarea id="answer-discuss-1" rows="3" placeholder="예: 하루 종일 유튜브 쇼츠를 볼 때는 눈이 빛나지만, 5분 동안 성경을 읽을 때는 도저히 집중하기 힘들어요..." class="w-full p-4 rounded-2xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent"></textarea>
        </div>
      </div>

      <!-- STEP 2: 말씀 속으로 (SCRIPTURE STUDY) -->
      <div id="step-2-content" class="step-content hidden space-y-6">
        
        <!-- INTRO CARD -->
        <div class="bg-slate-900 text-white rounded-3xl p-6 relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 opacity-10">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-40 h-40">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.053.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" />
            </svg>
          </div>
          <span class="text-amber-400 text-xs font-bold tracking-wider">BIBLE TIMELINE: B.C. 715</span>
          <h3 class="text-lg font-bold mt-1 mb-2 font-serif-kr">청년 왕 히스기야와 영적 개혁</h3>
          <p class="text-slate-300 text-xs leading-relaxed">
            아버지 '아하스 왕'은 성전 문을 대못으로 굳게 닫고 파괴했던 최고의 빌런이었습니다. 하지만 기도의 어머니 '아비야' 밑에서 자란 아들 히스기야는 25세 청년의 나이로 왕이 되자마자 놀라운 개혁을 이끕니다.
          </p>
        </div>

        <!-- INTERACTIVE WORKBOOK QUIZ -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 custom-shadow space-y-5">
          <h2 class="text-xl font-bold text-slate-900 mb-2 flex items-center space-x-2">
            <span class="text-amber-500">Q2.</span>
            <span>말씀 빈칸 퍼즐 완성하기</span>
          </h2>

          <!-- QUIZ ITEM 1 -->
          <div class="space-y-2">
            <p class="text-sm text-slate-700 font-medium">
              1) 히스기야는 즉위 원년 첫째 달에 가장 먼저 <span class="bg-amber-100 px-1 font-bold text-amber-900">이 일</span>을 시작했습니다. 나라가 흔들리는 진짜 원인은 경제나 군사력이 아니라, 하나님과의 관계, 즉 <input type="text" id="blank-1" placeholder="예배" class="w-16 text-center border-b-2 border-slate-300 focus:border-amber-500 focus:outline-none font-bold text-slate-800">의 파괴에 있었음을 알았기 때문입니다.
            </p>
          </div>

          <!-- QUIZ ITEM 2 -->
          <div class="space-y-2">
            <p class="text-sm text-slate-700 font-medium">
              2) 히스기야는 예배를 멈추고 사명을 버린 레위 사람들을 향해 11절에서 <strong class="text-red-500">"이제는 <input type="text" id="blank-2" placeholder="게으르지" class="w-20 text-center border-b-2 border-slate-300 focus:border-amber-500 focus:outline-none font-bold text-red-500"> 말라"</strong>고 선포합니다.
            </p>
          </div>

          <!-- QUIZ ITEM 3 -->
          <div class="space-y-2">
            <p class="text-sm text-slate-700 font-medium">
              3) '게으름'의 성경적 원어인 <span class="bg-amber-100 px-1 font-bold text-amber-900">아케디아(Acedia)</span>는 단순히 행동이 느린 것이 아니라, 하나님이 맡겨주신 내 영혼과 직분을 <input type="text" id="blank-3" placeholder="돌보지" class="w-16 text-center border-b-2 border-slate-300 focus:border-amber-500 focus:outline-none font-bold text-slate-800"> 않는 무책임한 상태를 뜻합니다.
            </p>
          </div>

          <!-- SUBMIT QUIZ -->
          <button onclick="checkAnswers()" class="w-full bg-slate-900 hover:bg-slate-800 text-white py-3 rounded-xl font-bold transition text-sm">
            정답 확인하기
          </button>
          
          <div id="quiz-result-msg" class="hidden p-3 rounded-xl text-center text-xs font-bold"></div>
        </div>

        <!-- DISCUSS 2 -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 custom-shadow">
          <h3 class="font-bold text-slate-900 mb-3 flex items-center space-x-1.5 text-sm uppercase tracking-wide">
            <span class="w-1.5 h-3 bg-amber-500 rounded-full"></span>
            <span>나눔 2. 깊은 묵상</span>
          </h3>
          <p class="text-slate-600 text-sm mb-4 leading-relaxed">
            히스기야 왕은 자신의 뜻을 펼칠 절대 권력을 가졌음에도, 세상의 번영보다 <strong>성전의 문을 여는 일</strong>을 제1원칙으로 삼았습니다. 내 삶에서 가장 먼저 '열고 수리해야 할 예배의 문'은 무엇인가요? (예: 일상의 큐티, 예배 지각 습관, 묵상 등)
          </p>
          <textarea id="answer-discuss-2" rows="3" placeholder="예: 주일에 피곤하다는 핑계로 예배 시간에 늦게 가는 습관을 가장 먼저 수리하고 싶습니다." class="w-full p-4 rounded-2xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent"></textarea>
        </div>

      </div>

      <!-- STEP 3: 삶의 적용 (LIFE APPLICATION) -->
      <div id="step-3-content" class="step-content hidden space-y-6">
        
        <!-- TOP WORKBOOK FOR STEP 3 -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 custom-shadow space-y-6">
          <h2 class="text-xl font-bold text-slate-900 flex items-center space-x-2">
            <span class="text-amber-500">Q3.</span>
            <span>우리의 영적 갓생(God-생)을 위한 결단</span>
          </h2>

          <!-- ACTION PLAN 1 -->
          <div class="space-y-3">
            <div class="flex items-center space-x-2">
              <span class="w-6 h-6 bg-amber-100 text-amber-900 rounded-full flex items-center justify-center font-bold text-xs">1</span>
              <h4 class="font-bold text-slate-800 text-sm">예배의 노-쇼(No-Show)를 중단하기</h4>
            </div>
            <p class="text-slate-500 text-xs leading-relaxed ml-8">
              이번 주부터 예배를 '시간이 나면' 드리는 자리가 아닌, 주일 시간표에 가장 먼저 <strong>고정해 두는</strong> 훈련을 합시다.
            </p>
            <div class="ml-8">
              <input type="text" id="action-worship" placeholder="나의 고정 예배 시간 (예: 청년부 오후 2시 예배 15분 전 도착)" class="w-full p-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
            </div>
          </div>

          <!-- ACTION PLAN 2 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <div class="flex items-center space-x-2">
              <span class="w-6 h-6 bg-amber-100 text-amber-900 rounded-full flex items-center justify-center font-bold text-xs">2</span>
              <h4 class="font-bold text-slate-800 text-sm">스크린 타임 10% 양도하기 (18분의 법칙)</h4>
            </div>
            <p class="text-slate-500 text-xs leading-relaxed ml-8">
              "기도할 시간이 없다"는 핑계는 이제 그만! 나의 하루 스마트폰 평균 사용 시간을 설정해보고, 딱 10%의 시간을 주님께 먼저 떼어 드립시다.
            </p>

            <!-- INTERACTIVE CALCULATOR -->
            <div class="ml-8 bg-amber-50/40 p-4 rounded-2xl border border-amber-100 space-y-4">
              <div>
                <label class="flex justify-between text-xs font-bold text-slate-700 mb-1">
                  <span>나의 하루 평균 스마트폰 사용 시간:</span>
                  <span id="screen-time-val" class="text-amber-700 font-extrabold text-sm">3시간</span>
                </label>
                <input type="range" id="screen-time" min="1" max="10" value="3" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-amber-500" oninput="updateCalculator()">
              </div>

              <!-- DYNAMIC RESULT -->
              <div class="p-3 bg-white rounded-xl border border-amber-100 text-center">
                <span class="text-xs text-slate-500">하루에 주님께 양도할 시간(10%)은</span>
                <div class="text-xl font-black text-slate-900 mt-1">
                  💡 딱 <span id="target-time" class="text-orange-500">18분</span> 입니다!
                </div>
              </div>

              <!-- DETAILED 18-MINUTE ALLOCATION PLAN -->
              <div class="space-y-2 pt-2">
                <p class="text-xs font-bold text-slate-600">이 시간을 어떻게 주님께 드릴까요?</p>
                
                <div class="grid grid-cols-3 gap-2">
                  <div class="bg-white p-2.5 rounded-xl border border-slate-100 text-center">
                    <span class="text-[10px] text-slate-400 block font-bold">아침 눈뜨자마자</span>
                    <span class="text-xs font-bold text-slate-700">3분 기도</span>
                  </div>
                  <div class="bg-white p-2.5 rounded-xl border border-slate-100 text-center">
                    <span class="text-[10px] text-slate-400 block font-bold">이동/자투리 시간</span>
                    <span class="text-xs font-bold text-slate-700">10분 성경 읽기</span>
                  </div>
                  <div class="bg-white p-2.5 rounded-xl border border-slate-100 text-center">
                    <span class="text-[10px] text-slate-400 block font-bold">밤 잠들기 전</span>
                    <span class="text-xs font-bold text-slate-700">5분 하루 회개</span>
                  </div>
                </div>

                <div class="mt-3">
                  <input type="text" id="action-screentime" placeholder="예: '18분의 법칙' 버스 안에서 숏츠 끊고 성경어플 1장 읽기!" class="w-full p-3 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-amber-400">
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- STEP 4: 결단 카드 (RESOLUTION) -->
      <div id="step-4-content" class="step-content hidden space-y-6">
        
        <div class="text-center space-y-1 mb-2">
          <p class="text-xs font-bold text-amber-600 uppercase tracking-widest">COMMITMENT CARD</p>
          <h2 class="text-xl font-black text-slate-900 font-serif-kr">나의 영적 불꽃 결단 카드</h2>
          <p class="text-slate-500 text-xs">작성한 고백을 확인하고, 캡처하거나 단톡방에 나눠보세요!</p>
        </div>

        <!-- GENERATED VISUAL CARD MOCKUP -->
        <div id="resolution-card" class="card-gradient border-2 border-amber-200 rounded-3xl p-6 custom-shadow relative overflow-hidden">
          <!-- CARD DECORATIVE LINES -->
          <div class="absolute -top-10 -left-10 w-32 h-32 bg-amber-200/20 rounded-full blur-xl"></div>
          <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-red-200/20 rounded-full blur-xl"></div>
          
          <div class="flex justify-between items-start mb-6">
            <div>
              <span class="text-[10px] bg-amber-500 text-white px-2 py-0.5 rounded-md font-bold tracking-wider">REVIVAL 2026</span>
              <h4 class="text-lg font-black text-slate-900 mt-1 font-serif-kr">내 안의 불꽃을 깨우라!</h4>
            </div>
            <div class="text-right">
              <span class="text-[10px] text-slate-400 block font-medium">작성자</span>
              <span id="card-author" class="font-bold text-slate-800 text-sm">홍길동 청년</span>
            </div>
          </div>

          <!-- CARD VALUES -->
          <div class="space-y-4 relative z-10">
            <!-- VALUE 1 -->
            <div class="bg-white/75 backdrop-blur-sm p-3.5 rounded-2xl border border-amber-100/50">
              <span class="text-[10px] font-bold text-amber-800 block mb-1">🔥 나의 생각 성찰 (게으름 극복)</span>
              <p id="card-discuss-1" class="text-xs text-slate-700 leading-relaxed italic">"성찰 질문을 성실히 입력해 주세요."</p>
            </div>

            <!-- VALUE 2 -->
            <div class="bg-white/75 backdrop-blur-sm p-3.5 rounded-2xl border border-amber-100/50">
              <span class="text-[10px] font-bold text-amber-800 block mb-1">🏛️ 수리해야 할 예배의 문</span>
              <p id="card-discuss-2" class="text-xs text-slate-700 leading-relaxed italic">"예배의 결단을 성실히 입력해 주세요."</p>
            </div>

            <!-- VALUE 3 -->
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-white/75 backdrop-blur-sm p-3.5 rounded-2xl border border-amber-100/50 text-center">
                <span class="text-[10px] font-bold text-amber-800 block mb-1">⏱️ 고정 예배 시간</span>
                <span id="card-worship" class="text-xs font-bold text-slate-800">미지정</span>
              </div>
              <div class="bg-white/75 backdrop-blur-sm p-3.5 rounded-2xl border border-amber-100/50 text-center">
                <span class="text-[10px] font-bold text-amber-800 block mb-1">📱 주님께 드릴 10%</span>
                <span id="card-screentime" class="text-xs font-bold text-slate-800">미지정</span>
              </div>
            </div>
          </div>

          <!-- CARD FOOTER TEXT -->
          <div class="mt-6 pt-4 border-t border-amber-200/50 text-center">
            <p class="text-[10px] font-bold text-slate-500 leading-relaxed italic">
              "내 아들들아 이제는 게으르지 말라\n여호와께서 이미 너희를 택하사 그를 섬기게 하셨느니라"\n- 역대하 29:11 -
            </p>
          </div>
        </div>

        <!-- SHARING OPTIONS -->
        <div class="space-y-3">
          <button onclick="copyToClipboard()" class="w-full bg-amber-500 hover:bg-amber-600 text-white py-3.5 rounded-xl font-bold transition flex items-center justify-center space-x-2 text-sm shadow-md shadow-amber-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.524 2.25h-3.048a2.25 2.25 0 0 0-2.142 1.638L5.25 11.25V18a2.25 2.25 0 0 0 2.25 2.25h9a2.25 2.25 0 0 0 2.25-2.25V11.25l-3.084-7.362ZM11.25 15.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM15 15.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
            <span>소그룹 단톡방 공유용 텍스트 복사하기</span>
          </button>
          
          <div id="copy-toast" class="hidden text-center text-xs font-bold text-green-600 p-2 bg-green-50 rounded-xl border border-green-200">
            복사 완료! 카카오톡이나 SNS에 바로 붙여넣어 마음을 나눠보세요.
          </div>
        </div>

      </div>

      <!-- PREV / NEXT BOTTOM NAVIGATION -->
      <div class="flex justify-between items-center pt-4 border-t border-slate-100">
        <button id="btn-prev" onclick="prevStep()" class="text-sm font-bold text-slate-500 hover:text-slate-900 transition flex items-center space-x-1">
          <span>&larr; 이전</span>
        </button>
        <button id="btn-next" onclick="nextStep()" class="bg-amber-500 hover:bg-amber-600 text-white px-6 py-2.5 rounded-xl font-bold transition text-sm">
          <span>다음 단계 &rarr;</span>
        </button>
      </div>

    </div>

  </main>

  <!-- FOOTER -->
  <footer class="text-center py-6 text-xs text-slate-400 border-t border-slate-100 mt-12">
    <p>© 2026 청년부 소그룹 교육 콘텐츠 개발팀. All rights reserved.</p>
    <p class="mt-1">"내 안의 불꽃을 다시 세우고, 무너진 성전의 예배를 다시 일으킵시다."</p>
  </footer>

  <!-- SCRIPT LOGIC -->
  <script>
    let currentStep = 1;
    let userName = "";

    // START WORKBOOK AFTER NAME INPUT
    function startWorkbook() {
      const nameInput = document.getElementById('user-name').value.trim();
      if (!nameInput) {
        alert("이름을 입력해 주셔야 공과 공부 결단 카드 생성이 가능합니다! 😊");
        return;
      }
      userName = nameInput;
      document.getElementById('display-name').innerText = userName;
      document.getElementById('card-author').innerText = userName + " 청년";
      
      // Screen transition
      document.getElementById('name-screen').classList.add('hidden');
      document.getElementById('workbook-screen').classList.remove('hidden');
      
      updateStepUI();
    }

    // TAB SYSTEM & SCREEN TRANSITION
    function switchStep(stepNum) {
      if (stepNum < 1 || stepNum > 4) return;
      currentStep = stepNum;
      updateStepUI();
    }

    function prevStep() {
      if (currentStep > 1) {
        currentStep--;
        updateStepUI();
      }
    }

    function nextStep() {
      if (currentStep < 4) {
        currentStep++;
        updateStepUI();
      } else {
        // Finalized
        alert("모든 공과 단계를 마쳤습니다! 결단 카드를 캡처하거나 텍스트로 복사하여 나누어 보세요! 🎉");
      }
    }

    function updateStepUI() {
      // Hide all step content
      document.querySelectorAll('.step-content').forEach(el => el.classList.add('hidden'));
      // Show active step
      document.getElementById(`step-${currentStep}-content`).classList.remove('hidden');

      // Update tabs UI
      for (let i = 1; i <= 4; i++) {
        const tab = document.getElementById(`tab-${i}`);
        if (i === currentStep) {
          tab.className = "flex-1 py-2 rounded-lg text-center whitespace-nowrap bg-white text-slate-900 shadow-sm font-bold";
        } else {
          tab.className = "flex-1 py-2 rounded-lg text-center whitespace-nowrap text-slate-500";
        }
      }

      // Update Progress Tracker
      document.getElementById('progress-text').innerText = `${currentStep}/4`;

      // Back/Next navigation button text/state
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');

      if (currentStep === 1) {
        btnPrev.classList.add('invisible');
      } else {
        btnPrev.classList.remove('invisible');
      }

      if (currentStep === 4) {
        btnNext.innerText = "완료하기 ✨";
      } else {
        btnNext.innerHTML = "다음 단계 &rarr;";
      }

      // Populate final card live on transition
      syncCard();
    }

    // CALCULATE LAZINESS SCORE (STEP 1)
    function calcLaziness() {
      const chks = document.querySelectorAll('.icebreaker-chk');
      let checkedCount = 0;
      chks.forEach(chk => {
        if (chk.checked) checkedCount++;
      });

      const percentage = (checkedCount / chks.length) * 100;
      document.getElementById('laziness-score').innerText = `${percentage}%`;
      
      const bar = document.getElementById('laziness-bar');
      bar.style.width = `${percentage}%`;

      let feedback = "";
      if (percentage === 0) {
        feedback = "우와! 영적인 긴장의 끈을 꽉 쥐고 있으시군요. 정말 대단합니다!";
      } else if (percentage <= 20) {
        feedback = "양호한 상태입니다. 하지만 조금씩 타협하는 지점이 생기고 있진 않은지 경계해봅시다.";
      } else if (percentage <= 60) {
        feedback = "주의 단계입니다. 바쁜 일상 속에서 나도 모르게 '예배와 사명'이 뒷전으로 밀리고 있는 것 같아요.";
      } else {
        feedback = "위험 단계입니다! 내면의 주님을 향한 불꽃이 꺼져가고 있진 않은가요? 오늘 회복의 첫 단추를 꿰어봅시다!";
      }
      document.getElementById('laziness-feedback').innerText = feedback;
    }

    // CHECK BIBLE PUZZLE ANSWERS (STEP 2)
    function checkAnswers() {
      const b1 = document.getElementById('blank-1').value.trim();
      const b2 = document.getElementById('blank-2').value.trim();
      const b3 = document.getElementById('blank-3').value.trim();

      const ans1 = "예배";
      const ans2 = "게으르지";
      const ans3 = "돌보지";

      const resultBox = document.getElementById('quiz-result-msg');
      resultBox.classList.remove('hidden');

      if (b1 === ans1 && b2 === ans2 && b3 === ans3) {
        resultBox.className = "p-3 rounded-xl text-center text-xs font-bold bg-green-50 text-green-700 border border-green-200 mt-4";
        resultBox.innerText = "🎉 대단해요! 모든 성경 키워드 퍼즐을 맞췄습니다! 하나님의 우선순위를 꿰뚫었군요.";
      } else {
        resultBox.className = "p-3 rounded-xl text-center text-xs font-bold bg-red-50 text-red-700 border border-red-200 mt-4";
        resultBox.innerHTML = `⚠️ 아쉬워요! 다시 한 번 설교 문맥을 확인해 보세요.<br>정답 힌트: 1) ${ans1}, 2) ${ans2}, 3) ${ans3}`;
      }
    }

    // UPDATE CALCULATOR (STEP 3)
    function updateCalculator() {
      const val = document.getElementById('screen-time').value;
      document.getElementById('screen-time-val').innerText = `${val}시간`;
      
      // Calculate 10%
      const targetMin = Math.round(val * 60 * 0.1);
      document.getElementById('target-time').innerText = `${targetMin}분`;
    }

    // SYNC DATA TO FINAL COMMITMENT CARD (STEP 4)
    function syncCard() {
      // Values from Step 1 & 2 나눔
      const discuss1 = document.getElementById('answer-discuss-1').value.trim();
      const discuss2 = document.getElementById('answer-discuss-2').value.trim();
      // Values from Step 3 결단
      const actionWorship = document.getElementById('action-worship').value.trim();
      const actionScreentime = document.getElementById('action-screentime').value.trim();
      const targetTime = document.getElementById('target-time').innerText;

      document.getElementById('card-discuss-1').innerText = discuss1 ? `"${discuss1}"` : "내가 영적으로 가장 소홀히 방치하고 있는 모습을 극복하기로 약속합니다.";
      document.getElementById('card-discuss-2').innerText = discuss2 ? `"${discuss2}"` : "주일 예배와 매일의 영적 제단을 다시 굳건하게 일으켜 세우겠습니다.";
      document.getElementById('card-worship').innerText = actionWorship ? actionWorship : "우선순위 고정 완료";
      document.getElementById('card-screentime').innerText = actionScreentime ? `${targetTime} 양도 (${actionScreentime})` : `매일 주님께 ${targetTime} 떼어드리기`;
    }

    // COPY CARD CONTENT AS PLAIN TEXT FOR SHARING (CLIPBOARD)
    function copyToClipboard() {
      const discuss1 = document.getElementById('answer-discuss-1').value.trim() || "말씀 적용 결단하기";
      const discuss2 = document.getElementById('answer-discuss-2').value.trim() || "무너진 예배 회복하기";
      const actionWorship = document.getElementById('action-worship').value.trim() || "시간표에 주일예배 고정";
      const actionScreentime = document.getElementById('action-screentime').value.trim() || "18분의 법칙 실천하기";
      const targetTime = document.getElementById('target-time').innerText;

      const textToCopy = `🔥 [내 안의 불꽃을 깨우라!] 나의 공과 공부 결단 카드

👤 이름: ${userName} 청년

1️⃣ 나의 영적 방치 점검: 
- ${discuss1}

2️⃣ 내가 수리해야 할 예배의 문:
- ${discuss2}

3️⃣ 구체적인 영적 갓생(God-생) 약속:
- [예배 노쇼 방지] ${actionWorship}
- [18분의 법칙] 매일 스마트폰 시간의 10%(${targetTime})를 주님께 양도!
  👉 실천 계획: ${actionScreentime}

"내 아들들아 이제는 게으르지 말라 여호와께서 이미 너희를 택하사 그를 섬기게 하셨느니라" (대하 29:11)`;

      // Clipboard copy using standard fallback for cross-origin iframes
      const tempTextArea = document.createElement("textarea");
      tempTextArea.value = textToCopy;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      document.execCommand("copy");
      document.body.removeChild(tempTextArea);

      // Show toast
      const toast = document.getElementById('copy-toast');
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }
  </script>
</body>
</html>
